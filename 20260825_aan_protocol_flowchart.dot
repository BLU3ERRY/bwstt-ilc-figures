digraph AANProtocol {
  graph [
    bgcolor="transparent",
    rankdir=TB,
    pad=0.18,
    nodesep=0.34,
    ranksep=0.58,
    splines=spline,
    outputorder=edgesfirst
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Noto Sans CJK KR",
    fontsize=15,
    margin="0.18,0.12",
    penwidth=1.8,
    color="#5279A3",
    fillcolor="#EAF2FB",
    fontcolor="#172033"
  ];

  edge [
    fontname="Noto Sans CJK KR",
    fontsize=12,
    fontcolor="#334155",
    color="#718096",
    penwidth=1.7,
    arrowsize=0.75
  ];

  A [label=<BASELINE HOLD<BR/><B>10-stride reference</B>>];
  B [label=<AVAILABILITY<BR/><B>Comparable now?</B>>];
  C [label=<STAY CONTROL vs ADJACENT BWS CANDIDATE<BR/><B>5 %BW step · p = 0.5</B>>, color="#64748B", fillcolor="#F1F5F9"];
  D [label=<SAFETY PROJECTION<BR/><B>Range · rate limit</B>>, color="#64748B", fillcolor="#F1F5F9"];
  E [label=<S-CURVE RAMP<BR/><B>Gradual 4-s transition</B>>, color="#64748B", fillcolor="#F1F5F9"];
  F [label=<DWELL<BR/><B>Observe 30 strides</B>>];
  MID [shape=point, width=0, height=0, label="", style=invis];

  { rank=same; A; B; C; MID; D; E; F; }
  A -> B -> C;
  C -> MID [arrowhead=none];
  MID -> D;
  D -> E -> F;

  CENTER [shape=point, width=0, height=0, label="", style=invis];
  MID -> CENTER [style=invis, weight=30];

  G [
    shape=diamond,
    style="filled",
    label=<GAIT MAINTAINED?<BR/><B>Safe and without substitution?</B>>,
    color="#C58A14",
    fillcolor="#FFF4D6",
    fontcolor="#4A3510",
    penwidth=2.2,
    margin="0.12,0.08"
  ];
  CENTER -> G [style=invis, weight=30];
  F -> G [constraint=false];

  H [label=<ACCEPT<BR/><B>Next probe</B>>, color="#2E8B57", fillcolor="#E8F6EE", fontcolor="#173F2B", penwidth=2.1];
  I [label=<HOLD<BR/><B>Keep current BWS</B>>, color="#C47A19", fillcolor="#FFF0DD", fontcolor="#4B3314", penwidth=2.1];
  J [label=<ROLLBACK / RECOVER UP<BR/><B>Increase BWS</B>>, color="#C94A5B", fillcolor="#FDE9EC", fontcolor="#5A1F28", penwidth=2.1];

  { rank=same; H; I; J; }
  G -> H [label="Maintained", color="#2E8B57"];
  G -> I [label="Borderline · uncertain", color="#C47A19"];
  G -> J [label="Deterioration · violation", color="#C94A5B"];

  K [label=<WASHOUT<BR/><B>10-stride stabilization before next probe</B>>, color="#735DA8", fillcolor="#F0ECFA", fontcolor="#30244A", penwidth=2.0];
  H -> K;
  I -> K;
  J -> K;

  K -> A [label="Repeat", style=dashed, color="#735DA8", fontcolor="#5B468A", constraint=false, minlen=3];
}
